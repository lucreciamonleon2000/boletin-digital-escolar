# .env.example - Plantilla de Variables de Entorno 

# Este archivo sirve como referencia de las variables necesarias.
# Copiá este archivo a .env en tu servidor y completá los valores reales.
# NUNCA guardes contraseñas reales ni API keys en este archivo.

# Entorno de ejecución: 'local' (desarrollo) o 'produccion' 
ENTORNO=local

# Conexión a la Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=boletin
DB_USER=root
DB_PASS=

# Servicio Cloud Externo 2: Resend API (Envío de Mails a Tutores)
# Obtené tu clave en: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_AVISOS=tu-correo-notificaciones@dominio.com

# Seguridad CORS (opcional en producción para restringir orígenes)
FRONTEND_ORIGIN=
